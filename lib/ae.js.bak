// Transport: runs ExtendScript jobs inside the RUNNING After Effects or Premiere Pro without touching the user's mouse/keyboard.
// Preferred: the KAI MCP Bridge CEP panel (cep/) lives inside each app, picks job files from a queue folder, and writes a
//   heartbeat every second, so the server knows whether the app is connected, busy with a job, or not responding.
// AE fallback "direct": Windows `AfterFX.exe -r job.jsx` / macOS `osascript ... DoScriptFile` (no panel needed).
// Premiere has no command-line script runner, so it always goes through the panel.
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { spawn, execFile } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
export const ROOT = path.resolve(HERE, '..');
const CFG_PATH = path.join(ROOT, 'config.json');

export function loadConfig() {
  let cfg = {};
  try { cfg = JSON.parse(fs.readFileSync(CFG_PATH, 'utf8')); } catch {}
  const home = os.homedir();
  cfg.workDir = cfg.workDir || path.join(home, 'KAI-AE-MCP-work');
  if (process.env.KAI_AE_MOCK) cfg.workDir = path.join(os.tmpdir(), 'kai-mcp-selftest'); // self-test never touches the real work folder
  cfg.mode = cfg.mode || 'auto';          // auto | direct | panel
  cfg.timeoutSec = cfg.timeoutSec || 120;
  for (const d of ['queue', 'results', 'frames', 'logs', 'checkpoints', 'renders', 'bridge', 'pr/queue', 'pr/results']) fs.mkdirSync(path.join(cfg.workDir, d), { recursive: true });
  return cfg;
}
export function saveConfig(cfg) { fs.writeFileSync(CFG_PATH, JSON.stringify(cfg, null, 2)); }

const PRELUDE = fs.readFileSync(path.join(ROOT, 'jsx', 'prelude.jsx'), 'utf8');
const PR_PRELUDE = fs.readFileSync(path.join(ROOT, 'jsx', 'pr_prelude.jsx'), 'utf8');
// Motion kit (MK.*): shape/text/keyframe helpers, loaded into every job so scripts never need $.evalFile or machine-specific paths.
const MOTIONKIT = fs.existsSync(path.join(ROOT, 'jsx', 'motionkit.jsx')) ? fs.readFileSync(path.join(ROOT, 'jsx', 'motionkit.jsx'), 'utf8') : '';

function jsxString(s) { return JSON.stringify(String(s)); } // JSON string literal is valid ExtendScript

// ExtendScript is ES3: reserved words can't be bare object keys ({in: 1}) or dot properties (o.in).
// Quote them automatically so a script never dies with "Illegal use of reserved word".
const RESERVED = 'in|delete|class|new|function|var|for|if|do|catch|finally|this|typeof|void|with|switch|return|try|throw|while|instanceof|else|break|continue|enum|export|extends|import|super|const|debugger';
export function fixReservedWords(code) {
  return String(code)
    .replace(new RegExp(`([{,]\\s*)(${RESERVED})(\\s*:)`, 'g'), "$1'$2'$3")
    .replace(new RegExp(`([A-Za-z0-9_$\\])])\\.(${RESERVED})\\b(?!\\s*\\()`, 'g'), "$1['$2']");
}

// Wrap user code: prelude + ARGS + undo group + try/catch + result file.
// expectedProject: refuse to run unless the open project's path contains this text (guards against editing the wrong file).
export function buildJob({ id, code, args = {}, undoName, resultPath, expectedProject, host = 'ae' }) {
  const rp = resultPath.replace(/\\/g, '/');
  if (host === 'pr') return buildPrJob({ id, code, args, rp, expectedProject });
  return `#target aftereffects
// KAI-RESULT: ${rp}
(function(){
${PRELUDE}
${MOTIONKIT}
var ARGS = ${JSON.stringify(args)};
var __claim = new File(${jsxString(rp)} + '.claim');
if (__claim.exists) return; // already picked up by the other transport
__claim.open('w'); __claim.write('1'); __claim.close();
var __res = { id: ${jsxString(id)}, ok: true, startedAt: new Date().getTime() };
var __undo = ${undoName ? jsxString('AI: ' + undoName) : 'null'};
try {
  ${guardJs(expectedProject, "app.project && app.project.file ? app.project.file.fsName : ''")}
  try { app.beginSuppressDialogs(); } catch (x) {}
  if (__undo) app.beginUndoGroup(__undo);
  // The code is compiled with eval so a syntax error becomes a normal exception that is
  // reported back to the caller, instead of an AE popup the user has to click away.
  var __fn = eval('(function(){\\n' + ${jsxString(fixReservedWords(code))} + '\\n})');
  __res.result = __fn();
} catch (e) {
  __res.ok = false; __res.error = e.toString(); try { __res.line = e.line; __res.kind = e.name; } catch (x) {}
} finally {
  try { if (__undo) app.endUndoGroup(); } catch (x) {}
  try { app.endSuppressDialogs(false); } catch (x) {}
}
__res.endedAt = new Date().getTime();
try { __res.project = app.project && app.project.file ? app.project.file.fsName : null; __res.dirty = app.project ? app.project.dirty : null; } catch (x) {}
KAI.writeText(${jsxString(rp)} + '.tmp', KAI.stringify(__res));
var __f = new File(${jsxString(rp)} + '.tmp'); __f.rename(${jsxString(path.basename(rp))}); try { __claim.remove(); } catch (x) {}
})();
`;
}

function guardJs(expected, openExpr) {
  if (!expected) return '';
  return `var __open = String(${openExpr}).replace(/\\\\/g, '/').toLowerCase(), __want = ${jsxString(String(expected).replace(/\\/g, '/').toLowerCase())};
  if (__open.indexOf(__want) < 0) throw new Error('Project guard: expected a project matching "' + __want + '" but the open project is "' + (__open || 'unsaved') + '". Nothing was changed.');`;
}

// Premiere job: no undo groups or dialog suppression in Premiere's ExtendScript DOM.
function buildPrJob({ id, code, args, rp, expectedProject }) {
  return `#target premierepro
// KAI-RESULT: ${rp}
(function(){
${PR_PRELUDE}
var ARGS = ${JSON.stringify(args)};
var __claim = new File(${jsxString(rp)} + '.claim');
if (__claim.exists) return;
__claim.open('w'); __claim.write('1'); __claim.close();
var __res = { id: ${jsxString(id)}, ok: true, startedAt: new Date().getTime() };
try {
  ${guardJs(expectedProject, "app.project ? app.project.path : ''")}
  var __fn = eval('(function(){\\n' + ${jsxString(fixReservedWords(code))} + '\\n})');
  __res.result = __fn();
} catch (e) {
  __res.ok = false; __res.error = e.toString(); try { __res.line = e.line; __res.kind = e.name; } catch (x) {}
}
__res.endedAt = new Date().getTime();
try { __res.project = app.project ? app.project.path : null; } catch (x) {}
KAI.writeText(${jsxString(rp)} + '.tmp', KAI.stringify(__res));
var __f = new File(${jsxString(rp)} + '.tmp'); __f.rename(${jsxString(path.basename(rp))}); try { __claim.remove(); } catch (x) {}
})();
`;
}

// ---------- bridge panel heartbeat ----------
// The CEP panel writes workDir/bridge/<host>.json every second:
// { host, app, version, pid, t, renderEngine, inFlight: {job, since} | null, lastReply }  (times in ms)
export function readHeartbeat(cfg, host) {
  try {
    const hb = JSON.parse(fs.readFileSync(path.join(cfg.workDir, 'bridge', host + '.json'), 'utf8'));
    const now = Date.now();
    hb.ageMs = now - hb.t;
    hb.connected = hb.ageMs < 4000 && !hb.renderEngine;
    hb.replyAgeMs = hb.lastReply ? now - hb.lastReply : null;
    hb.busyMs = hb.inFlight ? now - hb.inFlight.since : 0;
    return hb;
  } catch { return { connected: false, missing: true }; }
}
export function describeBridge(hb, appName) {
  if (!hb || hb.missing) return `${appName} bridge panel has never connected.`;
  if (!hb.connected) return `${appName} bridge panel is not connected (last heartbeat ${Math.round(hb.ageMs / 1000)}s ago${hb.renderEngine ? ', it is the Dynamic Link render engine' : ''}).`;
  if (hb.inFlight) return `${appName} is busy running job ${hb.inFlight.job} for ${Math.round(hb.busyMs / 1000)}s.`;
  if (hb.replyAgeMs > 8000) return `${appName} is not responding to scripts for ${Math.round(hb.replyAgeMs / 1000)}s (rendering, a modal dialog, or hung).`;
  return `${appName} connected and idle.`;
}

// ---------- locate / detect After Effects ----------
export function findAfterFX(cfg) {
  if (cfg.afterFX && fs.existsSync(cfg.afterFX)) return cfg.afterFX;
  if (process.platform === 'win32') {
    const roots = [process.env['ProgramFiles'] || 'C:\\Program Files'];
    for (const r of roots) {
      const base = path.join(r, 'Adobe');
      let dirs = []; try { dirs = fs.readdirSync(base).filter(d => /^Adobe After Effects (\d{4})$/.test(d)).sort().reverse(); } catch {}
      for (const d of dirs) { const p = path.join(base, d, 'Support Files', 'AfterFX.exe'); if (fs.existsSync(p)) return p; }
    }
  } else if (process.platform === 'darwin') {
    let dirs = []; try { dirs = fs.readdirSync('/Applications').filter(d => /^Adobe After Effects \d{4}$/.test(d)).sort().reverse(); } catch {}
    if (dirs.length) return path.join('/Applications', dirs[0]);
  }
  return null;
}

export function isPRRunning() {
  return new Promise((resolve) => {
    if (process.platform === 'win32') execFile('tasklist', ['/FI', 'IMAGENAME eq Adobe Premiere Pro.exe', '/NH'], (err, out) => resolve(!err && /Premiere/i.test(out)));
    else if (process.platform === 'darwin') execFile('/usr/bin/pgrep', ['-f', 'Adobe Premiere Pro'], (err, out) => resolve(!err && out.trim().length > 0));
    else resolve(false);
  });
}

export function isAERunning() {
  return new Promise((resolve) => {
    if (process.platform === 'win32') {
      execFile('tasklist', ['/FI', 'IMAGENAME eq AfterFX.exe', '/NH'], (err, out) => resolve(!err && /AfterFX\.exe/i.test(out)));
    } else if (process.platform === 'darwin') {
      execFile('/usr/bin/pgrep', ['-f', 'After Effects'], (err, out) => resolve(!err && out.trim().length > 0));
    } else resolve(false);
  });
}

function sendDirect(cfg, jobPath) {
  const exe = findAfterFX(cfg);
  if (!exe) throw new Error('After Effects not found. Set "afterFX" in config.json.');
  if (process.platform === 'win32') {
    const p = spawn(exe, ['-r', jobPath], { detached: true, stdio: 'ignore', windowsHide: true });
    p.unref();
  } else {
    const app = path.basename(exe).replace(/\.app$/, '');
    const as = `tell application "${app}" to DoScriptFile "${jobPath.replace(/"/g, '\\"')}"`;
    const p = spawn('/usr/bin/osascript', ['-e', as], { detached: true, stdio: 'ignore' }); p.unref();
  }
}

const sleep = (ms) => new Promise(r => setTimeout(r, ms));

let seq = 0;
// Run a job. Returns parsed result object {ok, result|error, ...}.
// host 'ae' (After Effects) or 'pr' (Premiere Pro).
export async function runJob(cfg, { code, args, undoName, timeoutSec, label, expectedProject, host = 'ae' }) {
  const appName = host === 'pr' ? 'Premiere Pro' : 'After Effects';
  if (process.env.KAI_AE_MOCK) { // self-test: syntax-check the generated ExtendScript without the app
    const { Script } = await import('node:vm');
    const src = buildJob({ id: 'mock', code, args, undoName, resultPath: '/tmp/mock.json', expectedProject, host }).replace(/^#target.*$/m, '');
    new Script(src); return { ok: true, result: { mock: true, label }, mode: 'mock' };
  }
  const sub = host === 'pr' ? 'pr' : '';
  const id = `${Date.now()}_${process.pid}_${++seq}`;
  const resultPath = path.join(cfg.workDir, sub, 'results', `${id}.json`);
  const jobPath = path.join(cfg.workDir, sub, 'queue', `${id}.jsx`);
  let hb = readHeartbeat(cfg, host);
  let mode;
  if (hb.connected) {
    // Fail fast instead of queueing behind a render or a dialog.
    if (hb.inFlight && hb.busyMs > 3000) throw new Error(describeBridge(hb, appName) + ' Wait for it to finish, or stop it in the app, then retry.');
    if (!hb.inFlight && hb.replyAgeMs !== null && hb.replyAgeMs > 8000) throw new Error(describeBridge(hb, appName) + ' Check the app for an open dialog or a running render.');
    mode = 'panel';
  } else if (host === 'pr') {
    if (!(await isPRRunning())) throw new Error('Premiere Pro is not running. Open Premiere Pro and your project first.');
    throw new Error(describeBridge(hb, appName) + ' In Premiere: Window > Extensions (Legacy) > KAI MCP Bridge (run install.bat once if it is not listed), or restart Premiere.');
  } else {
    if (!(await isAERunning())) throw new Error('After Effects is not running. Open After Effects (and your project) first.');
    mode = cfg.mode === 'auto' ? 'direct' : (cfg.mode === 'panel' ? 'panel' : 'direct');
  }
  fs.writeFileSync(jobPath, buildJob({ id, code, args, undoName, resultPath, expectedProject, host }), 'utf8');
  const tmo = (timeoutSec || cfg.timeoutSec) * 1000;
  if (mode === 'direct') sendDirect(cfg, jobPath);
  const t0 = Date.now();
  let lostSince = null;
  while (Date.now() - t0 < tmo) {
    if (fs.existsSync(resultPath)) {
      let txt = ''; for (let i = 0; i < 5; i++) { try { txt = fs.readFileSync(resultPath, 'utf8'); break; } catch { await sleep(100); } }
      try { fs.unlinkSync(jobPath); } catch {}
      if (host === 'ae' && cfg.lastWorkingMode !== mode) { cfg.lastWorkingMode = mode; try { saveConfig({ ...readCfgFile(), lastWorkingMode: mode }); } catch {} }
      const res = JSON.parse(txt);
      res.mode = mode; res.label = label;
      return res;
    }
    // Panel mode: if the heartbeat stops, the app crashed or froze completely; don't wait out the full timeout.
    if (mode === 'panel') {
      hb = readHeartbeat(cfg, host);
      if (!hb.connected) { lostSince = lostSince || Date.now(); if (Date.now() - lostSince > 10000) { try { fs.unlinkSync(jobPath); } catch {} throw new Error(`${appName} stopped responding while running this job (bridge heartbeat lost). It may have crashed or frozen.`); } }
      else lostSince = null;
    }
    await sleep(150);
  }
  try { fs.unlinkSync(jobPath); } catch {}
  hb = readHeartbeat(cfg, host);
  throw new Error(`Timed out after ${tmo / 1000}s waiting for ${appName}. ${hb.connected ? describeBridge(hb, appName) : 'It may be busy (render, modal dialog) or scripting may be blocked.'}` +
    (host === 'ae' ? ' Check Edit > Preferences > Scripting & Expressions > "Allow Scripts to Write Files and Access Network", and open Window > Extensions > KAI MCP Bridge for busy/hang detection.' : ''));
}
function readCfgFile() { try { return JSON.parse(fs.readFileSync(CFG_PATH, 'utf8')); } catch { return {}; } }
